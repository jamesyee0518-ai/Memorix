# Copy to a local env file or export these before starting the API.
# Do not commit real values. appsettings.json no longer contains secrets.

ASPNETCORE_ENVIRONMENT=Development

# postgres (default) or sqlite. sqlite does not require the connection string or MinIO keys.
DatabaseProvider=postgres

# Local docker-compose Postgres uses database knowledge_engine and user ke_user.
# Choose a password for that local role; do not reuse a password that was ever committed.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=knowledge_engine;Username=ke_user;Password=change-me

# At least 32 bytes. Generate with: openssl rand -base64 48
Jwt__Secret=replace-with-at-least-32-random-bytes
Jwt__Issuer=KnowledgeEngine
Jwt__Audience=KnowledgeEngine

Minio__Endpoint=localhost:9000
Minio__AccessKey=change-me
Minio__SecretKey=change-me
Minio__Bucket=knowledge-engine
